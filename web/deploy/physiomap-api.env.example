# PhysioMap knockout+curation API — secrets & config (NOT committed to git).
# Install as /etc/physiomap-api.env (chmod 600, owned root), then `systemctl restart physiomap-api`.
#
# Generate strong tokens:  openssl rand -hex 24
#
# Without these two tokens the editor still VALIDATES (open, read-only), but submit/review are
# disabled (fail-closed) — nothing can be written. Set them to let curators submit.

# Shared token you give to curators (George, Paul, …) so they can SUBMIT contributions:
PHYSIOMAP_EDIT_TOKEN=replace-with-openssl-rand-hex-24

# Maintainer-only token for deep-validate / approve / reject / fragment-export:
PHYSIOMAP_ADMIN_TOKEN=replace-with-a-different-openssl-rand-hex-24

# Where submissions are persisted (must be in the unit's ReadWritePaths):
PHYSIOMAP_CURATION_DIR=/var/lib/physiomap/curation
