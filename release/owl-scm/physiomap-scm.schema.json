        },
        "supporting_source_axioms": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Source Axioms",
          "type": "array"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id",
        "output_id",
        "pattern_id",
        "pattern_version",
        "reasoning_mode",
        "reasoner",
