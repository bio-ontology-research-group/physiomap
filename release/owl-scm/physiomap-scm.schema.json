          "title": "Evidence"
        },
        "evidence_status": {
          "enum": [
            "controlled",
            "legacy-evidence-unclassified"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mechanism": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mechanism"
        },
        "production_evidence": {
          "enum": [
            "curated_source_statement",
            "experimental_perturbation",
            "mechanistic_model",
            "legacy-evidence-unclassified"
