        },
        "sign": {
          "enum": [
            "+",
            "-",
            "?"
          ],
          "title": "Sign",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "trace_ids": {
          "items": {
            "type": "string"
          },
          "title": "Trace Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "sign",
        "production_evidence",
        "evidence_status",
        "trace_ids"
      ],
      "title": "ProductionRelation",
      "type": "object"
    },
