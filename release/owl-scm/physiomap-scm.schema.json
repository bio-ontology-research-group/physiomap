    "Scale": {
      "description": "Biological scale of a variable (coarse-grained, ordered fine -> coarse).",
      "enum": [
        "molecular",
        "subcellular",
        "cellular",
        "tissue",
        "organ",
        "organ_system",
        "organism"
      ],
      "title": "Scale",
