AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FB:gg") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NLM:alimentary+system") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Digestive_system") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001007> "Anatomical system that has as its parts the organs devoted to the ingestion, digestion, and assimilation of food and the discharge of residual wastes.")
