AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#sssom:mapping_justification> "https://w3id.org/semapv/vocab/LexicalMatching") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001173> "MESH:D001659")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001173> "SCTID:181267003")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ncithesaurus:Biliary_Tract") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001173> "UMLS:C0005423")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0001173> "Wikipedia:Biliary_tract")
