AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "AEO:0000112") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0005085> "epithelial placode")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0005085> "UBERON:0005085")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0005085> "ectodermal placode")
