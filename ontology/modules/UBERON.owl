AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VHOG:0001240") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0005792> "nephric cord")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0005792> "UBERON:0005792")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0005792> "nephric ridge")
