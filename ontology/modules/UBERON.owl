AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "EHDAA2:0004022") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MP:0011835") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0004876> "urogenital fold")
