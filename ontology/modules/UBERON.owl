SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GO-def") <http://purl.obolibrary.org/obo/UBERON_0004128> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/UBERON_0002346>))
SubClassOf(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFA") <http://purl.obolibrary.org/obo/UBERON_0004128> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002202> <http://purl.obolibrary.org/obo/UBERON_0003071>))

