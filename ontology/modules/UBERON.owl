AnnotationAssertion(<http://xmlns.com/foaf/0.1/depiction> <http://purl.obolibrary.org/obo/UBERON_0002342> "http://upload.wikimedia.org/wikipedia/commons/5/5f/Gray644.png"^^xsd:anyURI)
