AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/UBERON_0001232> <http://purl.obolibrary.org/obo/NCBITaxon_9606>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0005294") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFIN:curator") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001232> "Renal duct that collects the output from renal tubules.[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "FMA") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001232> "in ISBN:0073040584 (Vertebrates, Kardong), the nephron is adjacent to the collecting tubule, consistent with FMA, but not GO. Wikipedia says: Many sources include the connecting tubule as part of the collecting duct system. However, the embryological origin is more similar to the nephron than it is to the rest of the collecting duct (which derives from the ureteric bud), and other sources therefore classify the connecting tubule with the nephron")
