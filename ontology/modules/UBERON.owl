# Class: <http://purl.obolibrary.org/obo/UBERON_0002370> (thymus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NLM:thymus") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Thymus") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002370> "Anatomical structure of largely lymphoid tissue that functions in cell-mediated immunity by being the site where T cells develop.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0002370> "check - a subtype of gland? not in GO. NCIT has thymus and thymus gland. EHDAA2 has ductless gland.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/UBERON_0002370> <http://purl.obolibrary.org/obo/NCBITaxon_9606>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0010548") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:BJB") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002370> "Anatomical structure which originates as several paired thickenings on the dorsal side of the pharyngeal pouches and secretes thymosin.[AAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000253") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:978-0878932504 Gilbert SF, Developmental Biology (2006) p.558") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0002370> "A thymus develops in all vertebrates from the endodermal epithelium of certain pharyngeal pouches and from the adjacent ectodermal epithelium. In fishes, all the pouches, or the first four, contribute to thymus formation, but in tetrapods, the number is more restricted. In mammals, only the third and fourth are involved, and the contribution of the third is by far the greater.[well established][VHOG]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0002370> "thymic")
