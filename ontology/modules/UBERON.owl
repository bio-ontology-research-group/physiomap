# Class: <http://purl.obolibrary.org/obo/UBERON_0004141> (heart tube)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0003143") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mtg_heart") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0004141> "An epithelial tube that will give rise to the mature heart.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "MP:0012700") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0004141> "the paired, longitudinal, endothelial-lined channels formed from the cardiogenic mesoderm in embryonic development; angiogenic cell clusters (aka angioblastic cords) located in a horse-shoe shape configuration in the cardiogenic plate coalesce to form the right and left endocardial heart tubes which then fuse in cephalo-caudal direction to form a single primitive heart tube.")
