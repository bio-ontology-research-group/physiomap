AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Gallbladder") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002110> "An organ that aids digestion and stores bile produced by the liver[WP].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:9780120749034") <http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/UBERON_0002110> <http://purl.obolibrary.org/obo/NCBITaxon_10114>)
