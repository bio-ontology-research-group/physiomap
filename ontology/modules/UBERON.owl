# Class: <http://purl.obolibrary.org/obo/UBERON_0001134> (skeletal muscle tissue)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://github.com/obophenotype/uberon/issues/324") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001134> "Muscle tissue that consists primarily of skeletal muscle fibers.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0001134> "TODO - add skeletal muscle organ? See GO:0060538 skeletal muscle organ development. Todo - group FBbt:00005073 - somatic muscle.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0005277") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ZFIN:curator") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001134> "Muscle, composed of long cylindrical, multinucleated cells that attaches to the skeleton via tendons.[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "FMA:14069") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "FMA") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001134> "Tissue which consists of skeletal muscle fibers surrounded by endomysium. Examples: Skeletal muscle tissue of biceps, Skeletal muscle tissue of diaphragm[FMA]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000319") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PMID:10368962 Oota S, Saitou N, Phylogenetic relationship of muscle tissues deduced from superimposition of gene trees. Mol Biol Evol (1999)") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0001134> "This result implies the following views in terms of evolutionary differentiation: (1) Arthropod striated muscle and vertebrate skeletal and cardiac muscles share a common ancestor. In other words, they did not evolve independently (...) (5) The divergence of vertebrate skeletal and cardiac muscles/vertebrate smooth muscle and nonmuscle is at least before that of vertebrates/arthropods. In other words, emergence of skeletal and cardiac musle type tissues preceded the vertebrate/arthropod divergence (ca. 700 MYA).[well established][VHOG]")
