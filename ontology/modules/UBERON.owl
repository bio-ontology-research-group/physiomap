AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0004128> "ZFA:0000050")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0004128> "evagination")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "XAO:0000228") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0004128> "eye vesicle")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VHOG:0000165") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0004128> "ocular vesicle")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFA:0000050") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasSynonymType> <http://purl.obolibrary.org/obo/OMO_0003004>) <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/UBERON_0004128> "optic vesicles")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0004128> "UBERON:0004128")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0004128> <http://purl.obolibrary.org/obo/uberon/uberon-basic#pheno_slim>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0004128> <http://purl.obolibrary.org/obo/uberon/uberon-basic#vertebrate_core>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0004128> "Genes: Six3, Pax6, Rx1 are expressed together in the tip of the neural plate [ISBN:9780878932504 \"Developmental Biology\"]. Development notes: During subsequent develop- ment, the optic vesicle invaginates and becomes a two-layered structure with an inner neural retina and outer retinal pigment epithelium. As soon as the developing optic vesicle makes contact with the overlying ectoderm, it induces the ectoderm to thicken and form the lens placode [PMID:16496288]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0004128> "optic vesicle")
AnnotationAssertion(<http://xmlns.com/foaf/0.1/depiction> <http://purl.obolibrary.org/obo/UBERON_0004128> "http://upload.wikimedia.org/wikipedia/commons/e/e0/Gray863.png"^^xsd:anyURI)
