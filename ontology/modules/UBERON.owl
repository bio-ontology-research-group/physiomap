# Class: <http://purl.obolibrary.org/obo/UBERON_0006858> (adrenal/interrenal gland)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0030325") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0006858> "This gland can either be a discrete structure located bilaterally above each kidney, or a cluster of cells in the head kidney that perform the functions of the adrenal gland. In either case, this organ consists of two cells types, aminergic chromaffin cells and steroidogenic cortical cells[GO].")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0006858> "keep this grouping class so long as it is required for GO")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0001141") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:978-0030223693 Liem KF, Bemis WE, Walker WF, Grande L, Functional Anatomy of the Vertebrates: An Evolutionary Perspective (2001) p.518 and Figure 15-9") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0006858> "All craniates have groups of cells homologous to the mammalian adrenocortical and chromaffin tissues, but they are scattered in and near the kidneys in fishes. (...) The cortical and chromaffin tissues come together to form adrenal glands in tetrapods.[well established][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VHOG:0001141") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0006858> "adrenal gland - interrenal gland")
