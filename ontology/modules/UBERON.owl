# Class: <http://purl.obolibrary.org/obo/UBERON_0001434> (skeletal system)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000034") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:0000027") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://dx.plos.org/10.1371/journal.pone.0051070") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0001434> "Anatomical system that is a multi-element, multi-tissue anatomical cluster that consists of the skeleton and the articular system.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002171> <http://purl.obolibrary.org/obo/UBERON_0001434> <http://purl.obolibrary.org/obo/UBERON_0001016>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/UBERON_0001434> <http://purl.obolibrary.org/obo/NCBITaxon_9606>)
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "TAO:0000434") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "TAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "TAO:wd") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001434> "Anatomical system consisting of multiple elements and tissues that provides physical support.[TAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VSAO:0000027") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VSAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GO_REF:0000034, http://dx.plos.org/10.1371/journal.pone.0051070") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PSPUB:0000170") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001434> "Anatomical system that is a multi-element, multi-tissue anatomical cluster that consists of the skeleton and the articular system.[VSAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0000566") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:LAP") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0001434> "System that provides physical support to the organism.[AAO]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0001254") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "DOI:10.1159/000324245 Donoghue PCJ, Sansom IJ, Origin and early evolution of vertebrate skeletonization. Microscopy research and technique (2002)") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0001434> "By taking a holistic approach, integration of the evidence from molecular and developmental features of model organisms, the phylogenetic distribution in the 'new animal phylogeny' and the earliest fossilized remains of mineralized animal skeletons suggests independent origins of the skeleton at the phylum level.[debated][VHOG]")
AnnotationAssertion(<http://purl.obolibrary.org/obo/UBPROP_0000007> <http://purl.obolibrary.org/obo/UBERON_0001434> "skeletal")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#external_ontology> "GO") <http://purl.obolibrary.org/obo/UBPROP_0000012> <http://purl.obolibrary.org/obo/UBERON_0001434> "GO defines skeletal system very generically: The skeleton is the bony framework of the body in vertebrates (endoskeleton) or the hard outer envelope of insects (exoskeleton or dermoskeleton) GO:0001501; however, all annotations are to vertebrates")
