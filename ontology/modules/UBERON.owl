# Class: <http://purl.obolibrary.org/obo/UBERON_0003220> (metanephric mesenchyme)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0072075") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Metanephric_blastema") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0003220> "One of the two embryological structures that give rise to the kidney (the other is the ureteric bud). The metanephric blastema mostly develops into nephrons, but can also form parts of the collecting duct system.[WP]. Metanephric mesenchyme is the tissue made up of loosely connected mesenchymal cells in the metanephros[GO].")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000540") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://medical-dictionary.thefreedictionary.com/metanephric+mesenchyme") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0003220> "A mass of intermediate mesodermal cells around the distal end of the ureteric bud that gives rise to nephrons in the metanephric kidney. [TFD][VHOG]")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-09-17") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VHOG:0000540") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VHOG") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "ISBN:978-0878932504 Gilbert SF, Developmental Biology (2006) p.462") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "http://bgee.unil.ch/") <http://purl.obolibrary.org/obo/UBPROP_0000003> <http://purl.obolibrary.org/obo/UBERON_0003220> "When the ureteric buds emerge from the nephric duct, they enter the metanephrogenic mesenchyme. The ureteric buds induce this mesenchymal tissue to condense around them and differentiate into the nephrons of the mammalian kidney. As this mesenchyme differentiates, it tells the ureteric bud to branch and grow.[well established][VHOG]")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003220> "EHDAA2:0004062")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003220> "EHDAA:4041")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003220> "EHDAA:5021")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003220> "EHDAA:5915")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003220> "EMAPA:17375")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003220> "SCTID:361529008")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003220> "VHOG:0000540")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0003220> "Wikipedia:Metanephric_blastema")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Metanephric_blastema") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0003220> "metanephric blastema")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Metanephric_blastema") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0003220> "metanephric mesoderm")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "EHDAA:5021") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0003220> "metanephrogenic mesenchyme")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "RETIRED_EHDAA2:0001139") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0003220> "metanephros associated mesenchyme")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/UBERON_0003220> "UBERON:0003220")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/UBERON_0003220> <http://purl.obolibrary.org/obo/uberon/uberon-basic#pheno_slim>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0003220> "Genes: The positional specification of the metanephrogenic mesenchyme is negatively regulated by Foxc1 and Foxc2. Next the permanent kidney forming metanephrogenic mesenchyme is specified by Hox11 genes. The competence to respond to ureteric bud inducers is regulated by WT1. GDNF secretion restricted to posterior region by Robo2 and Sprouty1. The receptors for GDNF are synthesized in the nephric ducts and later in ureteric buds [ISBN:9780878932504 \"Developmental Biology\"]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0003220> "metanephric mesenchyme")
