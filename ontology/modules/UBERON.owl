AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0140512888") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Gonad") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFA:0000413") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ZFIN:curator") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0000991> "Reproductive organ that produces and releases eggs (ovary) or sperm (testis).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-06-20") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "AAO:0000213") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "AAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "AAO:BJB") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0000991> "Anatomical structure which produces gametes as well as certain sex hormones controlled by the pituitary gonadotropins.[AAO]")
