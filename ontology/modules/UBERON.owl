AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000034") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PSPUB:0000170") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "VSAO:0000047") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://dx.plos.org/10.1371/journal.pone.0051070") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0002481> "Skeletal tissue with a collagen-rich extracellular matrix vascularized, mineralized with hydroxyapatite and typically including osteocytes located in lacunae that communicate with one another by cell processes (in canaliculi). Bone is deposited by osteoblasts.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000116> <http://purl.obolibrary.org/obo/UBERON_0002481> "see https://github.com/obophenotype/uberon/issues/27")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#date_retrieved> "2012-08-14") Annotation(<http://www.geneontology.org/formats/oboInOwl#external_class> "VSAO:0000047") Annotation(<http://www.geneontology.org/formats/oboInOwl#ontology> "VSAO") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "GO_REF:0000034, http://dx.plos.org/10.1371/journal.pone.0051070") Annotation(<http://www.geneontology.org/formats/oboInOwl#source> "PSPUB:0000170") <http://purl.obolibrary.org/obo/UBPROP_0000001> <http://purl.obolibrary.org/obo/UBERON_0002481> "Skeletal tissue with a collagen-rich extracellular matrix vascularized, mineralized with hydroxyapatite and typically including osteocytes located in lacunae that communicate with one another by cell processes (in canaliculi). Bone is deposited by osteoblasts.[VSAO]")
