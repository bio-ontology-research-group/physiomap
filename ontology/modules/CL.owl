AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CL_0000417> "CL:0000417")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0000417> "endopolyploid cell")
