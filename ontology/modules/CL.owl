AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#sssom:mapping_justification> "https://w3id.org/semapv/vocab/UnspecifiedMatching") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/CL_0000311> "ZFA:0009157")
