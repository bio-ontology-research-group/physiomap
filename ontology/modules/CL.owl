AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10191060") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12128258") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34880760") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orcid.org/0000-0002-2244-7917") rdfs:comment <http://purl.obolibrary.org/obo/CL_4033050> "Frequently used when describing the developing nervous system in zebrafish. A catecholaminergic neuron expresses tyrosine hydroxylase (TH), tyrosine hydroxylase 2 (TH2), aromatic amino acid decarboxylase (AADC), dopamine b-hydroxylase (DBH), and phenylethanolamine-N-methyl transferase (PEMT), which are enzymes necessary for catecholamine synthesis.")
