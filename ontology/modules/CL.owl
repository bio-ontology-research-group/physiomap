# Class: <http://purl.obolibrary.org/obo/CL_0000115> (endothelial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:tfm") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MESH:D042783") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21275341") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://en.wikipedia.org/wiki/Endothelial_cell") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sourceforge.net/tracker/?func=detail&atid=440764&aid=3364936&group_id=36855") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_0000115> "An endothelial cell comprises the outermost layer or lining of anatomical structures and can be squamous or cuboidal. In mammals, endothelial cell has vimentin filaments and is derived from the mesoderm.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/CL_0000115> <http://purl.obolibrary.org/obo/NCBITaxon_9606>)
