AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CHEBI_65256> <http://purl.obolibrary.org/obo/3_STAR>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_65256> "antimicrobial food preservative")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_65256> <http://purl.obolibrary.org/obo/CHEBI_33281>)
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_65256> <http://purl.obolibrary.org/obo/CHEBI_65255>)

