AnnotationAssertion(Annotation(rdfs:label "Mitochondrial Fatty Acid Beta-Oxidation") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006635> "Reactome:R-HSA-77289")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0006635> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0006635> "GO:0006635")
