# Class: <http://purl.obolibrary.org/obo/GO_0000781> (chromosome, telomeric region)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:elh") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0000781> "The end of a linear chromosome, required for the integrity and maintenance of the end. A chromosome telomere usually includes a region of telomerase-encoded repeats the length of which rarely exceeds 20 bp each and that permits the formation of a telomeric loop (T-loop). The telomeric repeat region is usually preceded by a sub-telomeric region that is gene-poor but rich in repetitive elements. Some telomeres only consist of the latter part (for eg. D. melanogaster telomeres).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0000781> "GO:0000784")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0000781> "SO:0000624")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/GO_0000781> "nuclear chromosome, telomere")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/GO_0000781> "nuclear chromosome, telomeric region")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0000781> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000781> "telomere")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0000781> "GO:0000781")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0000781> "Note that this term can be used in place of the obsolete cellular component term 'telomere ; GO:0005696'. Use with caution because this term refers to a specific region of the chromosome and not a protein complex.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0000781> "chromosome, telomeric region")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0000781> <http://purl.obolibrary.org/obo/GO_0098687>)

# Class: <http://purl.obolibrary.org/obo/GO_0001503> (ossification)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mtg_mpo") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17572649") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0001503> "The formation of bone or of a bony substance, or the conversion of fibrous tissue or of cartilage into bone or a bony substance.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0001503> "Wikipedia:Ossification")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0001503> "bone biosynthesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0001503> "bone formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0001503> "osteogenesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0001503> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0001503> "GO:0001503")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0001503> "Note that this term does not have a 'developmental process' parent because ossification isn't necessarily developmental, can also occur as part of bone remodeling. Instead use 'ossification involved in bone maturation ; GO:0043931'.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0001503> "ossification")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0001503> <http://purl.obolibrary.org/obo/GO_0032501>)

