# Class: <http://purl.obolibrary.org/obo/GO_1990660> (calprotectin complex)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:bhm") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25417112") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_1990660> "A protein complex composed of S100A8 and S100A9 and capable of limiting Mn(2+) and Zn(2+) availability at sites of infection. Also binds Ca(2+). Expressed and released by neutrophils and epithelial cells, it exhibits broad-spectrum antimicrobial activity attributed to its metal-binding properties. Endogenous ligand of toll-like receptor 4 (TLR4) and of the receptor for advanced glycation end products (RAGE) initiating signal transduction through NF-kappa-B pathways.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/GO_1990660> "calprotectin heterodimer")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_1990660> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_1990660> "GO:1990660")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_1990660> "An example of this is S100A9 in human (UniProt symbol P06702) in PMID:25417112 (inferred from direct assay).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_1990660> "calprotectin complex")
SubClassOf(<http://purl.obolibrary.org/obo/GO_1990660> <http://purl.obolibrary.org/obo/GO_0032991>)

