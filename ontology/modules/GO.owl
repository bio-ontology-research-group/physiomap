AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0019814> "Note that an immunoglobulin complex has the function of antigen binding if a suitable antigen is available.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0019814> "immunoglobulin complex")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0019814> <http://purl.obolibrary.org/obo/GO_0032991>)

