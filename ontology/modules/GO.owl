AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0032281> "AMPA receptor")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0032281> "GO:0032281")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0032281> "AMPA glutamate receptor complex")
