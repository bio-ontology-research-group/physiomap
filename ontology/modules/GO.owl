AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0042627> "chylomicron")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0042627> <http://purl.obolibrary.org/obo/GO_0034358>)

