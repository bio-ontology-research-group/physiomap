AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0045202> <http://purl.obolibrary.org/obo/go#goslim_pir>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0045202> <http://purl.obolibrary.org/obo/go#goslim_synapse>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0045202> "synapse")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0045202> <http://purl.obolibrary.org/obo/GO_0030054>)

# Class: <http://purl.obolibrary.org/obo/GO_0045211> (postsynaptic membrane)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0198506732") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0045211> "A specialized area of membrane facing the presynaptic membrane on the tip of the nerve ending and separated from it by a minute cleft (the synaptic cleft). Neurotransmitters cross the synaptic cleft and transmit the signal to the postsynaptic membrane.")
