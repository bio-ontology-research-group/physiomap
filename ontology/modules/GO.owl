AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0070293> "renal absorption")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0070293> <http://purl.obolibrary.org/obo/GO_0003014>)

