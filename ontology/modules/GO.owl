# Class: <http://purl.obolibrary.org/obo/GO_0070254> (mucus secretion)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:add") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:068340007X") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0721662544") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0070254> "The regulated release of mucus by the mucosa. Mucus is a viscous slimy secretion consisting of mucins and various inorganic salts dissolved in water, with suspended epithelial cells and leukocytes. The mucosa, or mucous membrane, is the membrane covered with epithelium that lines the tubular organs of the body. Mucins are carbohydrate-rich glycoproteins that have a lubricating and protective function.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:add") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0070254> "mucus production")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0070254> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0070254> "GO:0070254")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0070254> "mucus secretion")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0070254> <http://purl.obolibrary.org/obo/GO_0007589>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0070254> <http://purl.obolibrary.org/obo/GO_0032941>)

# Class: <http://purl.obolibrary.org/obo/GO_0070288> (ferritin complex)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19154717") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33881539") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0070288> "A protein complex that binds iron and acts as a major iron storage system. There are three major subclasses of ferritins: the classical ferritins (Ftn), the heme-containing bacterioferritins (Bfr) and the DNA-binding proteins from starved cells (Dps). Ftn and Bfr are made of 24 subunits, whereas Dps are smaller with 12 subunits. Ftn is found in most kindoms, while Bfr and Dps are restricted to prokaryotes.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0070288> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0070288> "GO:0070288")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0070288> "ferritin complex")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0070288> <http://purl.obolibrary.org/obo/GO_0032991>)

# Class: <http://purl.obolibrary.org/obo/GO_0070293> (renal absorption)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dph") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:yaf") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0070293> "A renal system process in which water, ions, glucose and proteins are taken up from the collecting ducts, glomerulus and proximal and distal loops of the nephron. In non-mammalian species, absorption may occur in related structures (e.g. protein absorption is observed in nephrocytes in Drosophila, see PMID:23264686).")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0070293> "nephron absorption")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dph") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0070293> "renal reabsorption")
