# generated extraction artifacts (regenerable from scripts)
benchmarks/results/node_catalog.tsv
benchmarks/results/node_catalog.json
/benchmarks/results/extraction/

# institutional textbook PDFs (KAUST library, not redistributed)
/*.pdf
# third-party model/reference PDFs anywhere (copyright caution)
**/*.pdf
# binary office docs (working curation examples, not redistributed)
*.docx
*.doc

# External import dumps (SIGNOR / AOP-Wiki / INDRA) — large, reconstructable, not versioned
benchmarks/.imports/

# Citation verification: keep VERIFICATION.md, ignore raw API dumps + PDFs
resources/citation_verification/*.json
resources/citation_verification/*.xml
resources/citation_verification/*.pdf

# machine-specific symlink to the Overleaf paper checkout
/paper

