<https://w3id.org/physiomap/edge/causal/influence%3Asympathetic_tone%3Apositive%3Ahepatic_glucose_production> a pmo:CausalRelation ; pmo:hasSource <https://w3id.org/physiomap/node/sympathetic_tone> ; pmo:hasTarget <https://w3id.org/physiomap/node/hepatic_glucose_production> ; pmo:sign "+"
    ; dcterms:source "Catecholamine glycogenolysis; HumMod liver"
