    ; dcterms:source "the increase in body temperature during exercise, which stimulates ventilation... Heating of the skin may result in hyperventilation"
    ; pmo:mechanism "increased body temperature -> stimulation of ventilation"
    .
<https://w3id.org/physiomap/node/alveolar_po2> obo:RO_0002304 <https://w3id.org/physiomap/node/pulmonary_arteriole_diameter> .
<https://w3id.org/physiomap/edge/causal/influence%3Aalveolar_po2%3Apositive%3Apulmonary_arteriole_diameter> a pmo:CausalRelation ; pmo:hasSource <https://w3id.org/physiomap/node/alveolar_po2> ; pmo:hasTarget <https://w3id.org/physiomap/node/pulmonary_arteriole_diameter> ; pmo:sign "+"
    ; pmo:causalEvidence "perturbation"
